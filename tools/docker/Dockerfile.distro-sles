# EntropyFS distribution-court base image — SUSE Linux Enterprise Server
# 16 minimal.
#
# Phase 12E.8: SLES 16 container images are NOT publicly pullable; they
# require vendor registry credentials (registry.suse.com, subscription).
# This lane supports the AUTHENTICATED path: the driver reads
# SLES_REGISTRY_USER / SLES_REGISTRY_TOKEN (or a pre-existing docker
# login) and builds this Dockerfile against $SLES_IMAGE. Credentials are
# NEVER committed; when they are absent the driver records an explicit
# WAIVER with the exact failed pull + the requirement to clear it, and
# the lane is marked SKIPPED — not passed, not silently omitted.
#
# The legally distributable equivalent base (opensuse/leap) is exercised
# as an ADDITIONAL compatibility lane, explicitly documented as a
# substitute, not as the SLES lane.

ARG SLES_IMAGE=registry.suse.com/suse/sle16:latest
FROM $SLES_IMAGE

# Stage 2: documented build/runtime prerequisites (zypper).
# clang: libublk-rs-sys builds C bindings with bindgen (build-time
# libclang — exposed by the 12E.8 court).
RUN zypper --non-interactive install -y gcc gcc-c++ make curl file \
        diffutils util-linux python3 attr clang clang-devel \
    && zypper clean --all

# Stage 3: rustup pinned toolchain (never the distro's packaged Rust).
ENV RUSTUP_HOME=/opt/rust CARGO_HOME=/opt/cargo \
    PATH=/opt/cargo/bin:$PATH
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs \
    | sh -s -- -y --profile minimal --default-toolchain stable \
    && rustc --version

WORKDIR /src
CMD ["/bin/bash"]
